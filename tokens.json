{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Ardent Design System",
  "version": "0.1.3",
  "description": "Token specification for Ardent Design. Source of truth for color, typography, spacing, and component values across web, TUI, and GUI surfaces.",

  "philosophy": {
    "_tenetOrder_note": "When tenets conflict, apply in this order. Intentionality is the trump; respect-for-users is the floor.",
    "tenetOrder": [
      "intentionality",
      "transparency",
      "timelessness",
      "precision",
      "functionalDensity",
      "warmthThroughCraft",
      "performance",
      "respectForUsers"
    ]
  },

  "primitives": {
    "color": {
      "white": "#FFFFFF",
      "black": "#000000",

      "gray": {
        "50": "#FAFAFA",
        "100": "#F5F5F5",
        "200": "#E5E5E5",
        "300": "#D4D4D4",
        "400": "#A3A3A3",
        "500": "#737373",
        "600": "#525252",
        "700": "#404040",
        "800": "#262626",
        "900": "#0A0A0A",
        "950": "#050505"
      },

      "emerald": {
        "50": "#E6F6EC",
        "100": "#C3E9D2",
        "200": "#8FD5AC",
        "300": "#58C084",
        "400": "#26AB62",
        "500": "#009148",
        "600": "#007038",
        "700": "#00562B",
        "800": "#003F20",
        "900": "#002915"
      },

      "goldenrod": {
        "50": "#FFFAEB",
        "100": "#FFF0C2",
        "200": "#FFE285",
        "300": "#FFD147",
        "400": "#FFC01F",
        "500": "#FDB515",
        "600": "#C78D0A",
        "700": "#946805",
        "800": "#634503",
        "900": "#332301"
      },

      "ocean": {
        "50": "#E0F2F7",
        "100": "#B3DFF0",
        "200": "#80C2E8",
        "300": "#4DA1DE",
        "400": "#2680D0",
        "500": "#0060BF",
        "600": "#004A94",
        "700": "#00366E",
        "800": "#002447",
        "900": "#001224"
      },

      "red": {
        "50": "#FEF2F2",
        "100": "#FEE2E2",
        "200": "#FECACA",
        "300": "#FCA5A5",
        "400": "#F87171",
        "500": "#DC2626",
        "600": "#B91C1C",
        "700": "#991B1B",
        "800": "#7F1D1D",
        "900": "#450A0A"
      }
    },

    "fontFamily": {
      "sans": ["Inter", "Helvetica Neue", "Arial", "sans-serif"],
      "serif": ["Old Standard TT", "Source Serif", "Domine", "Times New Roman", "serif"],
      "mono": ["IBM Plex Mono", "Geist Mono", "Fira Code", "Berkeley Mono", "monospace"]
    },

    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem",
      "7xl": "4.5rem",
      "8xl": "6rem",
      "9xl": "8rem"
    },

    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },

    "lineHeight": {
      "none": 1,
      "extraTight": 1.1,
      "tight": 1.2,
      "snug": 1.25,
      "normal": 1.4,
      "relaxed": 1.5,
      "loose": 1.8
    },

    "letterSpacing": {
      "tighter": "-0.05em",
      "tight": "-0.025em",
      "normal": "0",
      "wide": "0.025em",
      "wider": "0.05em",
      "widest": "0.1em"
    },

    "_spacing_note": "4px base unit. Scale is monotonic — step number tracks size. Values are explicit; no synonyms.",
    "spacing": {
      "0": "0",
      "px": "1px",
      "0.5": "0.125rem",
      "1": "0.25rem",
      "1.5": "0.375rem",
      "2": "0.5rem",
      "2.5": "0.625rem",
      "3": "0.75rem",
      "3.5": "0.875rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "7": "1.75rem",
      "8": "2rem",
      "9": "2.25rem",
      "10": "2.5rem",
      "11": "2.75rem",
      "12": "3rem",
      "14": "3.5rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "28": "7rem",
      "32": "8rem"
    },

    "borderWidth": {
      "0": "0",
      "hairline": "1px",
      "default": "2px",
      "thick": "4px"
    },

    "_borderRadius_note": "Ardent rejects rounded corners. Only `none` should be consumed by components.",
    "borderRadius": {
      "none": "0"
    },

    "_motion_note": "Ardent rejects animation-without-purpose. Durations are pinned to zero so 'no transition' is canonical, not implied.",
    "motion": {
      "duration": {
        "instant": "0ms",
        "fast": "0ms",
        "normal": "0ms"
      },
      "easing": {
        "default": "linear",
        "in": "linear",
        "out": "linear",
        "inOut": "linear"
      }
    },

    "focus": {
      "color": "{primitives.color.black}",
      "width": "{primitives.borderWidth.default}",
      "offset": "{primitives.spacing.0.5}",
      "style": "solid"
    }
  },

  "semantic": {
    "light": {
      "color": {
        "bg": {
          "primary": "{primitives.color.white}",
          "secondary": "{primitives.color.gray.50}",
          "tertiary": "{primitives.color.gray.100}",
          "inverse": "{primitives.color.black}",
          "accent": "{primitives.color.emerald.500}",
          "accentSubtle": "{primitives.color.emerald.50}",
          "warning": "{primitives.color.goldenrod.50}",
          "warningSolid": "{primitives.color.goldenrod.500}",
          "info": "{primitives.color.ocean.50}",
          "infoSolid": "{primitives.color.ocean.500}",
          "error": "{primitives.color.red.50}",
          "errorSolid": "{primitives.color.red.500}"
        },
        "text": {
          "primary": "{primitives.color.black}",
          "secondary": "{primitives.color.gray.600}",
          "muted": "{primitives.color.gray.400}",
          "inverse": "{primitives.color.white}",
          "accent": "{primitives.color.emerald.600}",
          "warning": "{primitives.color.goldenrod.700}",
          "info": "{primitives.color.ocean.600}",
          "link": "{primitives.color.ocean.600}",
          "error": "{primitives.color.red.600}",
          "onAccent": "{primitives.color.black}"
        },
        "_border_note": "Each border token binds color AND width. Consumers pick one token, not two.",
        "border": {
          "default": {
            "color": "{primitives.color.black}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "strong": {
            "color": "{primitives.color.black}",
            "width": "{primitives.borderWidth.default}"
          },
          "muted": {
            "color": "{primitives.color.gray.200}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "accent": {
            "color": "{primitives.color.emerald.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "warning": {
            "color": "{primitives.color.goldenrod.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "info": {
            "color": "{primitives.color.ocean.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "error": {
            "color": "{primitives.color.red.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "focus": {
            "color": "{primitives.color.black}",
            "width": "{primitives.borderWidth.default}"
          }
        },
        "icon": {
          "primary": "{primitives.color.black}",
          "secondary": "{primitives.color.gray.500}",
          "accent": "{primitives.color.emerald.500}"
        }
      }
    },

    "dark": {
      "color": {
        "bg": {
          "primary": "{primitives.color.black}",
          "secondary": "{primitives.color.gray.950}",
          "tertiary": "{primitives.color.gray.900}",
          "inverse": "{primitives.color.white}",
          "accent": "{primitives.color.emerald.500}",
          "accentSubtle": "{primitives.color.emerald.900}",
          "warning": "{primitives.color.goldenrod.900}",
          "warningSolid": "{primitives.color.goldenrod.500}",
          "info": "{primitives.color.ocean.900}",
          "infoSolid": "{primitives.color.ocean.500}",
          "error": "{primitives.color.red.900}",
          "errorSolid": "{primitives.color.red.500}"
        },
        "text": {
          "primary": "{primitives.color.white}",
          "secondary": "{primitives.color.gray.400}",
          "muted": "{primitives.color.gray.600}",
          "inverse": "{primitives.color.black}",
          "accent": "{primitives.color.emerald.400}",
          "warning": "{primitives.color.goldenrod.300}",
          "info": "{primitives.color.ocean.400}",
          "link": "{primitives.color.ocean.400}",
          "error": "{primitives.color.red.400}",
          "onAccent": "{primitives.color.black}"
        },
        "border": {
          "default": {
            "color": "{primitives.color.white}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "strong": {
            "color": "{primitives.color.white}",
            "width": "{primitives.borderWidth.default}"
          },
          "muted": {
            "color": "{primitives.color.gray.800}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "accent": {
            "color": "{primitives.color.emerald.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "warning": {
            "color": "{primitives.color.goldenrod.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "info": {
            "color": "{primitives.color.ocean.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "error": {
            "color": "{primitives.color.red.500}",
            "width": "{primitives.borderWidth.hairline}"
          },
          "focus": {
            "color": "{primitives.color.white}",
            "width": "{primitives.borderWidth.default}"
          }
        },
        "icon": {
          "primary": "{primitives.color.white}",
          "secondary": "{primitives.color.gray.500}",
          "accent": "{primitives.color.emerald.400}"
        }
      }
    },

    "typography": {
      "displayLg": {
        "fontFamily": "{primitives.fontFamily.sans}",
        "fontSize": "{primitives.fontSize.8xl}",
        "fontWeight": "{primitives.fontWeight.bold}",
        "lineHeight": "{primitives.lineHeight.none}",
        "letterSpacing": "{primitives.letterSpacing.tighter}"
      },
      "display": {
        "fontFamily": "{primitives.fontFamily.sans}",
        "fontSize": "{primitives.fontSize.6xl}",
        "fontWeight": "{primitives.fontWeight.bold}",
        "lineHeight": "{primitives.lineHeight.extraTight}",
        "letterSpacing": "{primitives.letterSpacing.tight}"
      },
      "heading1": {
        "fontFamily": "{primitives.fontFamily.sans}",
        "fontSize": "{primitives.fontSize.4xl}",
        "fontWeight": "{primitives.fontWeight.bold}",
        "lineHeight": "{primitives.lineHeight.extraTight}",
        "letterSpacing": "{primitives.letterSpacing.tight}"
      },
      "heading2": {
        "fontFamily": "{primitives.fontFamily.sans}",
        "fontSize": "{primitives.fontSize.2xl}",
        "fontWeight": "{primitives.fontWeight.bold}",
        "lineHeight": "{primitives.lineHeight.snug}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      },
      "heading3": {
        "fontFamily": "{primitives.fontFamily.sans}",
        "fontSize": "{primitives.fontSize.xl}",
        "fontWeight": "{primitives.fontWeight.bold}",
        "lineHeight": "{primitives.lineHeight.snug}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      },
      "heading4": {
        "fontFamily": "{primitives.fontFamily.sans}",
        "fontSize": "{primitives.fontSize.lg}",
        "fontWeight": "{primitives.fontWeight.bold}",
        "lineHeight": "{primitives.lineHeight.normal}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      },
      "body": {
        "fontFamily": "{primitives.fontFamily.serif}",
        "fontSize": "{primitives.fontSize.base}",
        "fontWeight": "{primitives.fontWeight.regular}",
        "lineHeight": "{primitives.lineHeight.normal}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      },
      "bodyLarge": {
        "fontFamily": "{primitives.fontFamily.serif}",
        "fontSize": "{primitives.fontSize.lg}",
        "fontWeight": "{primitives.fontWeight.regular}",
        "lineHeight": "{primitives.lineHeight.relaxed}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      },
      "bodySmall": {
        "fontFamily": "{primitives.fontFamily.serif}",
        "fontSize": "{primitives.fontSize.sm}",
        "fontWeight": "{primitives.fontWeight.regular}",
        "lineHeight": "{primitives.lineHeight.normal}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      },
      "label": {
        "fontFamily": "{primitives.fontFamily.mono}",
        "fontSize": "{primitives.fontSize.xs}",
        "fontWeight": "{primitives.fontWeight.medium}",
        "lineHeight": "{primitives.lineHeight.normal}",
        "letterSpacing": "{primitives.letterSpacing.wider}",
        "textTransform": "uppercase"
      },
      "code": {
        "fontFamily": "{primitives.fontFamily.mono}",
        "fontSize": "{primitives.fontSize.sm}",
        "fontWeight": "{primitives.fontWeight.regular}",
        "lineHeight": "{primitives.lineHeight.normal}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      },
      "caption": {
        "fontFamily": "{primitives.fontFamily.mono}",
        "fontSize": "{primitives.fontSize.xs}",
        "fontWeight": "{primitives.fontWeight.regular}",
        "lineHeight": "{primitives.lineHeight.normal}",
        "letterSpacing": "{primitives.letterSpacing.wide}"
      },
      "metadata": {
        "fontFamily": "{primitives.fontFamily.mono}",
        "fontSize": "{primitives.fontSize.xs}",
        "fontWeight": "{primitives.fontWeight.regular}",
        "lineHeight": "{primitives.lineHeight.tight}",
        "letterSpacing": "{primitives.letterSpacing.normal}"
      }
    },

    "_semantic_spacing_note": "Named contexts. Consumers should reach for these first, primitives only when no semantic fits.",
    "spacing": {
      "page": {
        "margin": "{primitives.spacing.5}",
        "marginLg": "{primitives.spacing.12}",
        "maxWidth": "42.375rem",
        "maxWidthDoc": "47.5rem"
      },
      "section": {
        "gap": "{primitives.spacing.14}",
        "gapSm": "{primitives.spacing.8}",
        "gapXs": "{primitives.spacing.6}"
      },
      "stack": {
        "lede": "{primitives.spacing.3}",
        "paragraph": "{primitives.spacing.3}",
        "group": "{primitives.spacing.6}"
      },
      "card": {
        "padding": "{primitives.spacing.5}",
        "paddingSm": "{primitives.spacing.3}",
        "paddingLg": "{primitives.spacing.6}",
        "gap": "{primitives.spacing.3}"
      },
      "inline": {
        "gap": "{primitives.spacing.1.5}",
        "gapMd": "{primitives.spacing.2}",
        "gapLg": "{primitives.spacing.3}"
      },
      "control": {
        "paddingX": "{primitives.spacing.3}",
        "paddingY": "{primitives.spacing.1.5}"
      }
    },

    "border": {
      "card": {
        "width": "{primitives.borderWidth.hairline}",
        "radius": "{primitives.borderRadius.none}"
      },
      "input": {
        "width": "{primitives.borderWidth.hairline}",
        "radius": "{primitives.borderRadius.none}"
      },
      "button": {
        "width": "{primitives.borderWidth.hairline}",
        "radius": "{primitives.borderRadius.none}"
      },
      "divider": {
        "widthDefault": "{primitives.borderWidth.hairline}",
        "widthStrong": "{primitives.borderWidth.default}"
      }
    }
  },

  "components": {
    "card": {
      "background": "{semantic.light.color.bg.secondary}",
      "border": "{semantic.light.color.border.default}",
      "padding": "{semantic.spacing.card.padding}",
      "gap": "{semantic.spacing.card.gap}",
      "borderRadius": "{primitives.borderRadius.none}",
      "shadow": "none"
    },
    "button": {
      "_padding_note": "Order is `top/bottom left/right` per CSS shorthand.",
      "primary": {
        "background": "{primitives.color.emerald.400}",
        "backgroundHover": "{primitives.color.emerald.500}",
        "text": "{primitives.color.black}",
        "textHover": "{primitives.color.white}",
        "textWeight": "{primitives.fontWeight.medium}",
        "border": "{semantic.light.color.border.default}",
        "borderHover": "{primitives.color.emerald.500}",
        "fontFamily": "{primitives.fontFamily.sans}",
        "padding": "0.375rem 0.75rem",
        "textTransform": "uppercase",
        "letterSpacing": "{primitives.letterSpacing.wider}"
      },
      "secondary": {
        "background": "transparent",
        "backgroundHover": "{primitives.color.goldenrod.500}",
        "text": "{primitives.color.gray.900}",
        "textHover": "{primitives.color.white}",
        "textWeight": "{primitives.fontWeight.medium}",
        "border": "{primitives.color.goldenrod.500}",
        "fontFamily": "{primitives.fontFamily.sans}",
        "padding": "0.375rem 0.75rem",
        "textTransform": "uppercase",
        "letterSpacing": "{primitives.letterSpacing.wider}"
      },
      "ghost": {
        "background": "transparent",
        "backgroundHover": "{primitives.color.gray.100}",
        "text": "{primitives.color.gray.900}",
        "textWeight": "{primitives.fontWeight.medium}",
        "border": "transparent",
        "fontFamily": "{primitives.fontFamily.sans}",
        "padding": "0.375rem 0.75rem",
        "textTransform": "uppercase",
        "letterSpacing": "{primitives.letterSpacing.wider}"
      }
    },
    "link": {
      "color": "{semantic.light.color.text.link}",
      "colorHover": "{semantic.light.color.text.secondary}",
      "decoration": "underline",
      "decorationHover": "underline"
    },
    "input": {
      "background": "{primitives.color.white}",
      "border": "{primitives.color.gray.900}",
      "borderFocus": "{primitives.color.black}",
      "text": "{primitives.color.gray.900}",
      "placeholder": "{primitives.color.gray.400}",
      "fontFamily": "{primitives.fontFamily.sans}",
      "padding": "0.375rem 0.625rem"
    },
    "divider": {
      "color": "{semantic.light.color.border.default}",
      "colorStrong": "{semantic.light.color.border.strong}",
      "colorMuted": "{semantic.light.color.border.muted}"
    },
    "label": {
      "fontFamily": "{primitives.fontFamily.mono}",
      "fontSize": "{primitives.fontSize.xs}",
      "fontWeight": "{primitives.fontWeight.medium}",
      "textTransform": "uppercase",
      "letterSpacing": "{primitives.letterSpacing.wider}",
      "color": "{semantic.light.color.text.secondary}"
    }
  },

  "_surfaces_note": "Ardent targets web, TUI and GUI. The web tokens above are authoritative; these blocks describe how the same vocabulary translates to the other two surfaces.",
  "surfaces": {
    "web": {
      "implementation": "CSS custom properties generated from this file. Hairlines render as 1px solid borders; flat surfaces, no shadow."
    },
    "tui": {
      "implementation": "ANSI escape codes. Terminal font (monospace) for everything by default — no family swap required.",
      "color": {
        "primary": { "ansi": "0 / 15", "note": "Default fg/bg (terminal palette)." },
        "secondary": { "ansi": "8", "note": "Bright black for muted labels." },
        "accent": { "ansi": "2", "note": "Green — emerald." },
        "warning": { "ansi": "3", "note": "Yellow — goldenrod." },
        "info": { "ansi": "4", "note": "Blue — ocean." },
        "error": { "ansi": "1", "note": "Red." }
      },
      "type": {
        "all": "Terminal monospace (no family swap; rely on the user's terminal font).",
        "label": "Uppercase, no letter-spacing (terminals do not subpixel-shift).",
        "metadata": "ANSI dim attribute (\\u001b[2m)."
      },
      "border": {
        "hairline": "Box-drawing glyphs ─ │ ┌ ┐ └ ┘",
        "strong": "Double box-drawing glyphs ═ ║ ╔ ╗ ╚ ╝"
      }
    },
    "gui": {
      "implementation": "Platform-native rendering (Qt / Cocoa / Win32 / GTK). Use the same hex values; respect the platform dark-mode toggle.",
      "type": "Same three families. Fall back to the platform's system mono if IBM Plex Mono is not installed.",
      "border": "1px hairline at logical pixels. No platform-native rounded corners or drop shadows."
    }
  }
}
